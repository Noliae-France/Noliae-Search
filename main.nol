import "vendor/nolc/lib/web.nol"
import "views/search.nol"

fn ctrl_accueil(_req: Requete, _p: Map<Text>) -> WebResultat {
    return WebResultat.WebOk(reponse_html(vue_search("Noliae Search", "", "text", "")))
}

fn ctrl_recherche(req: Requete, _p: Map<Text>) -> WebResultat {
    let q = unwrap_or(requete_query(req, "q"), "")
    let mode = unwrap_or(requete_query(req, "mode"), "text")
    var message = "Entrez une recherche pour commencer."
    if q != "" { message = "La recherche « " + q + " » sera envoyée au NolCore via /v1/search/" + mode + "/:keyword." }
    return WebResultat.WebOk(reponse_html(vue_search("Noliae Search", q, mode, message)))
}

fn ctrl_sante(_req: Requete, _p: Map<Text>) -> WebResultat { return WebResultat.WebOk(reponse_json("{\"status\":\"ok\",\"service\":\"noliae-search\",\"runtime\":\"nolc\"}")) }

fn application(req: Requete) -> WebResultat {
    var m: List<Text> = []; var p: List<Text> = []; var h: List<Fn(Requete, Map<Text>) -> WebResultat> = []
    route_type(m,p,h,"GET","/",ctrl_accueil); route_type(m,p,h,"GET","/recherche",ctrl_recherche); route_type(m,p,h,"GET","/api/health",ctrl_sante)
    if starts_with(req.chemin,"/static/") { let f=servir_statique(".",req.chemin); if has(f) { return WebResultat.WebOk(reponse_avec_entete(reponse_texte(unwrap_or(f,"")),"Content-Type",type_mime(req.chemin))) } }
    return routeur_dispatch_type(m,p,h,req)
}

fn main() { let port=unwrap_or(parse_int(unwrap_or(env("NOLIAE_PORT"),"8080")),8080); let l=tcp_listen(port); if not has(l){return}; let s=unwrap_or(l,-1); let limites=web_limites_defaut(); var post: List<Fn(Requete,Reponse)->Reponse> = [];push(post,middleware_securite);push(post,middleware_request_id);while true{let a=tcp_accept(s);if has(a){let f=unwrap_or(a,-1);let raw=unwrap_or(tcp_read(f),"");let rep=web_repondre_resultat(raw,limites,application,post);let _w=tcp_write(f,rep);tcp_close(f)}} }
