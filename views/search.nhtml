@model(titre: Text, query: Text, mode: Text, message: Text)
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#111111">
  <title>@titre — Recherche</title>
  <meta name="description" content="Noliae Search : une recherche claire, reliée à vos services Noliae et protégée par le Core.">
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
  <link rel="canonical" href="//">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="Noliae">
  <meta property="og:title" content="Noliae Search — Explorer sans bruit">
  <meta property="og:description" content="Une recherche claire, reliée à vos services Noliae.">
  <meta property="og:url" content="//">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Noliae Search — Explorer sans bruit">
  <meta name="twitter:description" content="Une recherche claire, reliée à vos services Noliae.">
  <script type="application/ld+json">{"@@context":"https://schema.org","@@type":"WebSite","name":"Noliae Search","url":"//","potentialAction":{"@@type":"SearchAction","target":"//recherche?q={search_term_string}","query-input":"required name=search_term_string"}}</script>  <link rel="stylesheet" href="/static/bulma.min.css"><link rel="stylesheet" href="/static/noliae.css">
  <style>@@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}.hero>*{animation:rise .55s cubic-bezier(.2,.8,.2,1) both}.hero-copy{animation-delay:.08s}.search-form{animation-delay:.16s}.quick-links{animation-delay:.24s}.topbar{border:0;background:transparent}.hero{min-height:calc(100vh - 62px);padding:0 24px 10vh;display:flex;flex-direction:column;justify-content:center;border:0;background:transparent}.hero .cap,.hero h1{display:none}.hero-copy{order:3;max-width:430px;margin:18px auto 0;font-size:14px}.hero-copy::before{content:'noliae.';display:block;font:500 52px/1 var(--mono);letter-spacing:-.1em;color:#111;margin-bottom:20px}.hero-copy::after{content:'Recherche indépendante, sans contenu inventé.';display:block;color:var(--pulse);font:11px var(--mono);letter-spacing:.05em;margin-top:9px}.search-form{order:2;max-width:600px;border:1px solid var(--line);border-radius:99px;box-shadow:0 1px 4px #00000008;padding:3px 7px 3px 17px}.search-form button{border-radius:99px;padding:0 17px;height:38px}.search-form select{display:none}.search-icon.wave{margin-right:2px}.search-icon.wave i{background:var(--ink)}.search-icon.wave i:nth-child(4){background:var(--pulse)}.quick-links{order:4}.results-shell{border-top:1px solid var(--line);max-width:none}.principles{display:none}.site-footer{background:#f4f4f0}.brand{background:transparent;color:var(--ink);padding:0}.brand .wave i{background:var(--ink)}.brand .wave i:nth-child(4){background:var(--pulse)}.brand b{border:0;padding:0;color:var(--pulse)}body.has-query .hero{min-height:0;padding:18px 24px;justify-content:flex-start}body.has-query .hero-copy{display:none}body.has-query .quick-links{display:none}body.has-query .search-form{max-width:640px;margin:0 auto}body.has-query .results-shell{min-height:calc(100vh - 130px);max-width:750px;grid-template-columns:1fr;margin:0 auto}body.has-query .filters{display:flex;flex-direction:row;gap:4px;padding:14px 0;border-right:0;border-bottom:1px solid var(--line);align-items:center}body.has-query .filters .cap{display:none}body.has-query .filter{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:99px}body.has-query .filter-note{display:none}body.has-query .result-content{padding:20px 0}body.has-query .result-head{display:none}@@media(max-width:680px){.hero-copy::before{font-size:42px}.hero{min-height:calc(100vh - 62px)}body.has-query .hero{padding:16px 18px}}.pagination{display:flex;align-items:center;justify-content:center;gap:14px;margin-top:28px;padding-top:20px;border-top:1px solid var(--line)}.pagination button{border:1px solid var(--line);background:#fff;border-radius:99px;padding:8px 18px;font:12px var(--mono);cursor:pointer}.pagination button:disabled{opacity:.35;cursor:default}.pagination span{font:11px var(--mono);color:#777}.result-card.has-thumb{display:flex;gap:16px;align-items:flex-start}.result-thumb{width:96px;height:96px;object-fit:cover;border-radius:8px;border:1px solid var(--line);flex:none;background:#f2f2ee}.result-thumb.icon{object-fit:contain;padding:18px;background:#fff}@@media(max-width:520px){.result-thumb{width:64px;height:64px}}.result-columns{display:flex;align-items:flex-start;gap:36px}.result-main{flex:1;min-width:0}#wiki-panel{width:300px;flex:none;padding:20px;border:1px solid var(--line);border-radius:12px;background:#fff}#wiki-panel img{width:100%;height:150px;object-fit:cover;border-radius:8px;margin-bottom:14px;background:#f2f2ee}#wiki-panel h3{font:600 17px var(--sans);margin:0 0 8px;letter-spacing:-.01em}#wiki-panel p{font-size:13px;line-height:1.6;color:#555;margin:0 0 12px}#wiki-panel a{font:600 12px var(--sans);color:var(--pulse);text-decoration:none}body.has-query .results-shell{max-width:1040px}@@media(max-width:900px){.result-columns{flex-direction:column}#wiki-panel{width:100%}}</style>
</head>
<body>
  <header class="topbar">
    <a class="brand" data-app="search" href="/" aria-label="Noliae Search">
      <span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span data-brand>noliae</span><b>search</b>
    </a>
    <nav aria-label="Navigation principale">
      <a href="#principes">À propos</a>
      <a data-app="ia" href="/">Noliae IA</a>
      <a class="account" data-app="account" href="/compte">Compte <span>↗</span></a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="title">
      <p class="cap"><i></i> Recherche Noliae <span>·</span> Beta</p>
      <h1 id="title">Explorer<br><em>sans bruit.</em></h1>
      <p class="hero-copy">Retrouvez l’essentiel, avec une interface calme reliée à votre espace Noliae.</p>
      <form class="search-form" action="/recherche" method="get">
        <label class="sr-only" for="q">Rechercher sur Noliae</label>
        <span class="search-icon wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
        <input id="q" name="q" value="@query" placeholder="Rechercher sur Noliae" autocomplete="off" autofocus>
        <select name="mode" aria-label="Type de recherche">
          <option value="text">Web</option>
          <option value="img">Images</option>
          <option value="ia">Réponse IA</option>
        </select>
        <button type="submit">Rechercher <b>↵</b></button>
      </form>
      <div class="quick-links" aria-label="Recherches suggérées">
        <span>À essayer</span><a href="/recherche?q=Noliae&amp;mode=text">Noliae</a><a href="/recherche?q=IA&amp;mode=ia">IA</a><a href="/recherche?q=Documentation&amp;mode=text">Documentation</a>
      </div>
    </section>

    <section class="results-shell" aria-live="polite">
      <aside class="filters">
        <p class="cap">Affiner</p>
        <a class="filter active" href="/recherche?q=@query&amp;mode=text"><span>◉</span> Tout</a>
        <a class="filter" href="/recherche?q=@query&amp;mode=img"><span>○</span> Images</a>
        <a class="filter" href="/recherche?q=@query&amp;mode=ia"><span>○</span> Réponse IA</a>
        <div class="filter-note"><i></i><p>Vos accès et limites sont appliqués côté serveur.</p></div>
      </aside>
      <div class="result-content">
        <div class="result-head"><p class="cap">Mode <strong>@mode</strong></p><span>Recherche protégée par Noliae</span></div>
        <div class="result-columns">
          <div class="result-main">
            <div id="results-live" data-query="@query" data-mode="@mode">
              @if(query == "")
                <article class="empty-state"><img class="empty-mark" src="/static/symbol-dark.svg" alt="" aria-hidden="true"><h2>Recherchez ce qui compte.</h2><p>Les résultats apparaîtront ici, sans contenu inventé.</p></article>
              @else
                <article class="result-card"><small>Recherche en cours</small><h2>Recherche de « @query »</h2><p>Interrogation des sources disponibles…</p></article>
              @endif
            </div>
            <nav id="results-pagination" class="pagination" aria-label="Pages de résultats" hidden></nav>
          </div>
          <aside id="wiki-panel" hidden></aside>
        </div>
      </div>
    </section>

    <section id="principes" class="principles">
      <header><p class="cap"><i></i> Principes de recherche</p><p>Une interface qui privilégie le signal.</p></header>
      <div class="grid">
        <article><small>01 / UTILE</small><h2>Un résultat doit mériter votre attention.</h2><p>Hiérarchie claire, lecture fluide, aucun élément conçu pour distraire.</p></article>
        <article><small>02 / CONNECTÉ</small><h2>La recherche parle à vos outils.</h2><p>Le Core rassemble sessions, données, crawler et recherche assistée par IA.</p></article>
        <article><small>03 / MAÎTRISÉ</small><h2>Vos règles suivent chaque requête.</h2><p>Les permissions et les limites de débit restent appliquées côté serveur.</p></article>
      </div>
    </section>
  </main>
  <footer class="site-footer"><span>© Noliae</span><a data-app="ia" href="/">Noliae IA</a><a data-app="search" href="/">Accueil</a><span class="version">SEARCH / 01</span></footer>
<script src="/static/links.js"></script></body>
<script>(async()=>{const p=location.hostname.split('.'),a=p.length<3?location.origin:location.protocol+'//api.'+p.slice(1).join('.'),root=document.getElementById('results-live'),pager=document.getElementById('results-pagination'),wikiPanel=document.getElementById('wiki-panel'),esc=v=>String(v||'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])),stripHtml=v=>String(v||'').replace(/<[^>]*>/g,'').replace(/&(#x?[0-9a-f]+|[a-z]+);/gi,e=>{const named={amp:'&',lt:'<',gt:'>',quot:'"',apos:"'",nbsp:' '};let m=/^&#x([0-9a-f]+);$/i.exec(e);if(m)return String.fromCodePoint(parseInt(m[1],16));m=/^&#(\d+);$/.exec(e);if(m)return String.fromCodePoint(parseInt(m[1],10));const nm=e.slice(1,-1).toLowerCase();return named[nm]!==undefined?named[nm]:e;});const q=root.dataset.query,mode=root.dataset.mode,params=new URLSearchParams(location.search);let page=parseInt(params.get('page')||'1',10);if(!Number.isFinite(page)||page<1)page=1;if(q)document.body.classList.add('has-query');const goToPage=n=>{const u=new URL(location.href);u.searchParams.set('page',n);location.href=u.toString()};const renderPager=(current,totalPages)=>{if(!totalPages||totalPages<=1){pager.hidden=true;pager.innerHTML='';return}pager.hidden=false;pager.innerHTML="<button type='button' data-dir='prev'"+(current<=1?' disabled':'')+">← Précédent</button><span>Page "+current+" / "+totalPages+"</span><button type='button' data-dir='next'"+(current>=totalPages?' disabled':'')+">Suivant →</button>";const prev=pager.querySelector("[data-dir='prev']"),next=pager.querySelector("[data-dir='next']");if(prev)prev.addEventListener('click',()=>goToPage(current-1));if(next)next.addEventListener('click',()=>goToPage(current+1))};try{const rep=await fetch(a+'/v1/search/'+encodeURIComponent(mode)+'/'+encodeURIComponent(q)+'?page='+page,{credentials:'include'}),data=await rep.json();if(!q)return;if(!rep.ok){root.innerHTML="<article class='empty-state'><h2>Recherche indisponible</h2><p>"+esc(data.detail||'Veuillez réessayer.')+"</p></article>";return}var rows=Array.isArray(data)?data:(data.results||data.items||[]);if(!rows.length){root.innerHTML="<article class='empty-state'><h2>Aucun résultat</h2><p>Nous n’avons trouvé aucun résultat pour cette recherche.</p></article>";wikiPanel.hidden=true;return}const wikiIdx=rows.findIndex(x=>/wikipedia\.org/i.test(String(x.url||x.link||'')));if(wikiIdx>-1){const w=rows[wikiIdx];rows=rows.slice(0,wikiIdx).concat(rows.slice(wikiIdx+1));const wTitle=esc(stripHtml(w.title||'Wikipédia')),wText=esc(stripHtml(w.description||w.content||'').slice(0,260)),wUrl=String(w.url||w.link||''),wImg=imgOf(w);wikiPanel.hidden=false;wikiPanel.innerHTML=(wImg.url&&!wImg.icon?"<img src='"+esc(wImg.url)+"' alt='' loading='lazy' referrerpolicy='no-referrer' onerror='this.remove()'>":'')+"<h3>"+wTitle+"</h3><p>"+wText+"…</p>"+(wUrl?"<a rel='noopener noreferrer' target='_blank' href='"+esc(wUrl)+"'>Voir sur Wikipédia →</a>":'')}else{wikiPanel.hidden=true;wikiPanel.innerHTML=''}const imgOf=x=>({url:x.image||x.thumbnail&&x.thumbnail.src||x.properties&&x.properties.url||x.img_src||'',icon:false}).url?{url:x.image||x.thumbnail&&x.thumbnail.src||x.properties&&x.properties.url||x.img_src,icon:false}:(x.meta_url&&x.meta_url.favicon||x.favicon)?{url:x.meta_url&&x.meta_url.favicon||x.favicon,icon:true}:{url:'/static/symbol-dark.svg',icon:true};root.innerHTML=rows.map(x=>{const title=esc(stripHtml(x.title||x.name||x.url||'Résultat')),url=String(x.url||x.link||''),text=esc(stripHtml(x.description||x.content||x.snippet||'')),source=esc(x.source||x.domain||'web'),imgInfo=imgOf(x),img=imgInfo.url;return "<article class='result-card"+(img?' has-thumb':'')+"'>"+(img?"<img class='result-thumb"+(imgInfo.icon?' icon':'')+"' src='"+esc(img)+"' alt='' loading='lazy' referrerpolicy='no-referrer' onerror='this.remove()'>":'')+"<div><small>"+source+"</small><h2>"+title+"</h2><p>"+text.slice(0,420)+"</p>"+(url?"<a rel='noopener noreferrer' target='_blank' href='"+esc(url)+"'>Ouvrir le résultat <span>→</span></a>":'')+"</div></article>"}).join('');const totalPages=parseInt(rep.headers.get('X-Total-Pages')||'0',10);renderPager(page,totalPages)}catch(_){if(q)root.innerHTML="<article class='empty-state'><h2>Connexion impossible</h2><p>Le service de recherche ne répond pas pour le moment.</p></article>"}})();</script>
</html>
