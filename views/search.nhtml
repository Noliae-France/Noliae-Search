@model(titre: Text, query: Text, mode: Text, message: Text)
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#111111">
  <title>@titre — Recherche</title>
  <meta name="description" content="Noliae Search : une recherche claire, reliée à vos services Noliae et protégée par le Core.">
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
  <link rel="canonical" href="https://noliae.com/">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="Noliae">
  <meta property="og:title" content="Noliae Search — Explorer sans bruit">
  <meta property="og:description" content="Une recherche claire, reliée à vos services Noliae.">
  <meta property="og:url" content="https://noliae.com/">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Noliae Search — Explorer sans bruit">
  <meta name="twitter:description" content="Une recherche claire, reliée à vos services Noliae.">
  <script type="application/ld+json">{"@@context":"https://schema.org","@@type":"WebSite","name":"Noliae Search","url":"https://noliae.com/","potentialAction":{"@@type":"SearchAction","target":"https://noliae.com/recherche?q={search_term_string}","query-input":"required name=search_term_string"}}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/static/noliae.css">
  <style>@@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}@@keyframes scan{50%{transform:scaleX(.75);opacity:.55}}.hero>*{animation:rise .65s cubic-bezier(.2,.8,.2,1) both}.hero h1{animation-delay:.08s}.hero-copy{animation-delay:.16s}.search-form{animation-delay:.24s}.quick-links{animation-delay:.32s}.wave i:nth-child(4){animation:scan 1.6s ease-in-out infinite}.filter,.result-card,.grid article{transition:transform .2s ease,background .2s ease,border-color .2s ease}.filter:hover,.result-card:hover{transform:translateX(3px)}.grid article:hover{transform:translateY(-4px)}.empty-mark{width:54px;height:54px;object-fit:contain;margin-bottom:2px}@@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}</style>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/" aria-label="Noliae Search">
      <span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span>noliae</span><b>search</b>
    </a>
    <nav aria-label="Navigation principale">
      <a href="https://ia.noliae.com">Noliae IA</a>
      <a href="#principes">Notre approche</a>
      <a class="account" href="/compte">Compte <span>↗</span></a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="title">
      <p class="cap"><i></i> Recherche Noliae <span>·</span> Beta</p>
      <h1 id="title">Explorer<br><em>sans bruit.</em></h1>
      <p class="hero-copy">Un moteur de recherche calme, connecté à vos espaces Noliae et construit pour retrouver l’essentiel.</p>
      <form class="search-form" action="/recherche" method="get">
        <label class="sr-only" for="q">Rechercher sur Noliae</label>
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input id="q" name="q" value="@query" placeholder="Rechercher sur Noliae" autocomplete="off" autofocus>
        <select name="mode" aria-label="Type de recherche">
          <option value="text">Web</option>
          <option value="img">Images</option>
          <option value="ia">Réponse IA</option>
        </select>
        <button type="submit">Rechercher <b>↵</b></button>
      </form>
      <div class="quick-links" aria-label="Recherches suggérées">
        <span>À essayer</span><a href="/recherche?q=Noliae&amp;mode=text">Noliae</a><a href="/recherche?q=IA&amp;mode=ia">IA</a><a href="/recherche?q=Documentation&amp;mode=text">Documentation</a>
      </div>
    </section>

    <section class="results-shell" aria-live="polite">
      <aside class="filters">
        <p class="cap">Affiner</p>
        <a class="filter active" href="/recherche?q=@query&amp;mode=text"><span>◉</span> Tout</a>
        <a class="filter" href="/recherche?q=@query&amp;mode=img"><span>○</span> Images</a>
        <a class="filter" href="/recherche?q=@query&amp;mode=ia"><span>○</span> Réponse IA</a>
        <div class="filter-note"><i></i><p>Vos accès et limites sont appliqués par NolCore.</p></div>
      </aside>
      <div class="result-content">
        <div class="result-head"><p class="cap">Mode <strong>@mode</strong></p><span>Recherche protégée par Noliae</span></div>
        @if(query == "")
          <article class="empty-state">
            <img class="empty-mark" src="/static/symbol-dark.svg" alt="" aria-hidden="true"><h2>Prêt quand vous l’êtes.</h2><p>Commencez par une idée, une page ou un sujet. Noliae organise le reste.</p>
          </article>
        @else
          <article class="result-card primary-result">
            <small>Résultat Noliae</small><h2>@query</h2><p>@message</p><a href="#core">Ouvrir dans votre espace <span>→</span></a>
          </article>
          <article class="result-card"><small>Fonctionnement</small><h3>Résultats reliés au Core</h3><p>Les requêtes passent par le gateway NolCore, ses permissions et ses limites avant toute réponse.</p></article>
        @endif
      </div>
    </section>

    <section id="principes" class="principles">
      <header><p class="cap"><i></i> Principes de recherche</p><p>Une interface qui privilégie le signal.</p></header>
      <div class="grid">
        <article><small>01 / UTILE</small><h2>Un résultat doit mériter votre attention.</h2><p>Hiérarchie claire, lecture fluide, aucun élément conçu pour distraire.</p></article>
        <article><small>02 / CONNECTÉ</small><h2>La recherche parle à vos outils.</h2><p>Le Core rassemble sessions, données, crawler et recherche assistée par IA.</p></article>
        <article><small>03 / MAÎTRISÉ</small><h2>Vos règles suivent chaque requête.</h2><p>Les permissions et les limites de débit restent appliquées côté serveur.</p></article>
      </div>
    </section>
  </main>
  <footer class="site-footer"><span>© Noliae</span><a href="https://ia.noliae.com">Noliae IA</a><a href="https://noliae.com">Accueil</a><span class="version">SEARCH / 01</span></footer>
</body>
<script>(async()=>{const h=location.hostname;const a=h.startsWith("search.")?location.protocol+"//api."+h.slice(7):location.origin;try{const r=await fetch(a+"/v1/branding");if(!r.ok)return;const b=await r.json(),n=b.name||"NolCore";document.title=n+" — Recherche";document.querySelectorAll("a").forEach(x=>{if(x.href.includes("ia."))x.href=b.ia_url||x.href;else if(x.href.includes("noliae.com"))x.href=b.website_url||x.href});document.querySelectorAll(".brand span:not(.wave),.site-footer span:first-child").forEach(x=>{if(x.textContent.includes("noliae")||x.textContent.includes("Noliae"))x.textContent=x.textContent.replace(/noliae/gi,n)})}catch(_){}})();</script>
</html>
