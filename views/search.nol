fn vue_search(titre: Text, query: Text, mode: Text, message: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#111111\">\n  <title>"
    _o += html_escape(titre)
    _o += " — Recherche</title>\n  <meta name=\"description\" content=\"Noliae Search : une recherche claire, reliée à vos services Noliae et protégée par le Core.\">\n  <meta name=\"robots\" content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\">\n  <link rel=\"canonical\" href=\"//\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:locale\" content=\"fr_FR\">\n  <meta property=\"og:site_name\" content=\"Noliae\">\n  <meta property=\"og:title\" content=\"Noliae Search — Explorer sans bruit\">\n  <meta property=\"og:description\" content=\"Une recherche claire, reliée à vos services Noliae.\">\n  <meta property=\"og:url\" content=\"//\">\n  <meta name=\"twitter:card\" content=\"summary\">\n  <meta name=\"twitter:title\" content=\"Noliae Search — Explorer sans bruit\">\n  <meta name=\"twitter:description\" content=\"Une recherche claire, reliée à vos services Noliae.\">\n  <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Noliae Search\",\"url\":\"//\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"//recherche?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}}</script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link rel=\"stylesheet\" href=\"/static/noliae.css\">\n  <style>@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}.hero>*{animation:rise .55s cubic-bezier(.2,.8,.2,1) both}.hero-copy{animation-delay:.08s}.search-form{animation-delay:.16s}.quick-links{animation-delay:.24s}.topbar{border:0;background:transparent}.hero{min-height:calc(100vh - 62px);padding:0 24px 10vh;display:flex;flex-direction:column;justify-content:center;border:0;background:transparent}.hero .cap,.hero h1{display:none}.hero-copy{order:3;max-width:430px;margin:18px auto 0;font-size:14px}.hero-copy::before{content:'noliae.';display:block;font:500 52px/1 var(--mono);letter-spacing:-.1em;color:#111;margin-bottom:20px}.hero-copy::after{content:'Recherche indépendante, sans contenu inventé.';display:block;color:var(--pulse);font:11px var(--mono);letter-spacing:.05em;margin-top:9px}.search-form{order:2;max-width:600px;border:1px solid var(--line);border-radius:99px;box-shadow:0 1px 4px #00000008;padding:3px 7px 3px 17px}.search-form button{border-radius:99px;padding:0 17px;height:38px}.search-form select{display:none}.search-icon{font-size:20px}.quick-links{order:4}.results-shell{border-top:1px solid var(--line);max-width:none}.principles{display:none}.site-footer{background:#f4f4f0}.brand{background:transparent;color:var(--ink);padding:0}.brand .wave i{background:var(--ink)}.brand .wave i:nth-child(4){background:var(--pulse)}.brand b{border:0;padding:0;color:var(--pulse)}@media(max-width:680px){.hero-copy::before{font-size:42px}.hero{min-height:calc(100vh - 62px)}}</style>\n</head>\n<body>\n  <header class=\"topbar\">\n    <a class=\"brand\" href=\"/\" aria-label=\"Noliae Search\">\n      <span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>\n      <span>noliae</span><b>search</b>\n    </a>\n    <nav aria-label=\"Navigation principale\">\n      <a href=\"/\">À propos</a>\n      <a href=\"/\">Noliae IA</a>\n      <a class=\"account\" href=\"/compte\">Compte <span>↗</span></a>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero\" aria-labelledby=\"title\">\n      <p class=\"cap\"><i></i> Recherche Noliae <span>·</span> Beta</p>\n      <h1 id=\"title\">Explorer<br><em>sans bruit.</em></h1>\n      <p class=\"hero-copy\">Retrouvez l’essentiel, avec une interface calme reliée à votre espace Noliae.</p>\n      <form class=\"search-form\" action=\"/recherche\" method=\"get\">\n        <label class=\"sr-only\" for=\"q\">Rechercher sur Noliae</label>\n        <span class=\"search-icon\" aria-hidden=\"true\">⌕</span>\n        <input id=\"q\" name=\"q\" value=\""
    _o += html_escape(query)
    _o += "\" placeholder=\"Rechercher sur Noliae\" autocomplete=\"off\" autofocus>\n        <select name=\"mode\" aria-label=\"Type de recherche\">\n          <option value=\"text\">Web</option>\n          <option value=\"img\">Images</option>\n          <option value=\"ia\">Réponse IA</option>\n        </select>\n        <button type=\"submit\">Rechercher <b>↵</b></button>\n      </form>\n      <div class=\"quick-links\" aria-label=\"Recherches suggérées\">\n        <span>À essayer</span><a href=\"/recherche?q=Noliae&amp;mode=text\">Noliae</a><a href=\"/recherche?q=IA&amp;mode=ia\">IA</a><a href=\"/recherche?q=Documentation&amp;mode=text\">Documentation</a>\n      </div>\n    </section>\n\n    <section class=\"results-shell\" aria-live=\"polite\">\n      <aside class=\"filters\">\n        <p class=\"cap\">Affiner</p>\n        <a class=\"filter active\" href=\"/recherche?q="
    _o += html_escape(query)
    _o += "&amp;mode=text\"><span>◉</span> Tout</a>\n        <a class=\"filter\" href=\"/recherche?q="
    _o += html_escape(query)
    _o += "&amp;mode=img\"><span>○</span> Images</a>\n        <a class=\"filter\" href=\"/recherche?q="
    _o += html_escape(query)
    _o += "&amp;mode=ia\"><span>○</span> Réponse IA</a>\n        <div class=\"filter-note\"><i></i><p>Vos accès et limites sont appliqués par NolCore.</p></div>\n      </aside>\n      <div class=\"result-content\">\n        <div class=\"result-head\"><p class=\"cap\">Mode <strong>"
    _o += html_escape(mode)
    _o += "</strong></p><span>Recherche protégée par Noliae</span></div>\n        <div id=\"results-live\" data-query=\""
    _o += html_escape(query)
    _o += "\" data-mode=\""
    _o += html_escape(mode)
    _o += "\">\n          "
    if query == "" {
    _o += "\n            <article class=\"empty-state\"><img class=\"empty-mark\" src=\"/static/symbol-dark.svg\" alt=\"\" aria-hidden=\"true\"><h2>Recherchez ce qui compte.</h2><p>Les résultats apparaîtront ici, sans contenu inventé.</p></article>\n          "
    } else {
    _o += "\n            <article class=\"result-card\"><small>Recherche en cours</small><h2>Recherche de « "
    _o += html_escape(query)
    _o += " »</h2><p>Interrogation de l’index NolCore…</p></article>\n          "
    }
    _o += "\n        </div>\n      </div>\n    </section>\n\n    <section id=\"principes\" class=\"principles\">\n      <header><p class=\"cap\"><i></i> Principes de recherche</p><p>Une interface qui privilégie le signal.</p></header>\n      <div class=\"grid\">\n        <article><small>01 / UTILE</small><h2>Un résultat doit mériter votre attention.</h2><p>Hiérarchie claire, lecture fluide, aucun élément conçu pour distraire.</p></article>\n        <article><small>02 / CONNECTÉ</small><h2>La recherche parle à vos outils.</h2><p>Le Core rassemble sessions, données, crawler et recherche assistée par IA.</p></article>\n        <article><small>03 / MAÎTRISÉ</small><h2>Vos règles suivent chaque requête.</h2><p>Les permissions et les limites de débit restent appliquées côté serveur.</p></article>\n      </div>\n    </section>\n  </main>\n  <footer class=\"site-footer\"><span>© Noliae</span><a href=\"/\">Noliae IA</a><a href=\"/\">Accueil</a><span class=\"version\">SEARCH / 01</span></footer>\n</body>\n<script>(async()=>{const h=location.hostname,a=h.startsWith(\"search.\")?location.protocol+\"//api.\"+h.slice(7):location.origin,root=document.getElementById(\"results-live\"),esc=v=>String(v||\"\").replace(/[&<>\\\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"\\\"\":\"&quot;\"}[c]));try{const r=await fetch(a+\"/v1/branding\"),b=r.ok?await r.json():{},n=b.name||\"NolCore\";document.title=n+\" — Recherche\";document.querySelectorAll(\".brand span:not(.wave),.site-footer span:first-child\").forEach(x=>{if(/noliae/i.test(x.textContent))x.textContent=x.textContent.replace(/noliae/gi,n)});const q=root.dataset.query,mode=root.dataset.mode;if(!q)return;const rep=await fetch(a+\"/v1/search/\"+encodeURIComponent(mode)+\"/\"+encodeURIComponent(q),{credentials:\"include\"}),data=await rep.json();if(!rep.ok){root.innerHTML=\"<article class='empty-state'><h2>Recherche indisponible</h2><p>\"+esc(data.detail||\"Veuillez réessayer.\")+\"</p></article>\";return}const rows=Array.isArray(data)?data:[];if(!rows.length){root.innerHTML=\"<article class='empty-state'><h2>Aucun résultat indexé</h2><p>Cette recherche est en cours d’indexation.</p></article>\";return}root.innerHTML=rows.map(x=>{const title=esc(x.title||x.url||\"Résultat\"),url=String(x.url||\"\"),text=esc(x.description||x.content||\"\"),source=esc(x.source||\"web\");return \"<article class='result-card'><small>\"+source+\"</small><h2>\"+title+\"</h2><p>\"+text.slice(0,420)+\"</p>\"+(url?\"<a rel='noopener noreferrer' target='_blank' href='\"+esc(url)+\"'>Ouvrir le résultat <span>→</span></a>\":\"\")+\"</article>\"}).join(\"\")}catch(_){if(root.dataset.query)root.innerHTML=\"<article class='empty-state'><h2>Connexion impossible</h2><p>Le NolCore ne répond pas pour le moment.</p></article>\"}})();</script>\n</html>\n"
    return _o
}
