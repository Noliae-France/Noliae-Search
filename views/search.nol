fn vue_search(titre: Text, query: Text, mode: Text, message: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#111111\">\n  <title>"
    _o += html_escape(titre)
    _o += " — Recherche</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link rel=\"stylesheet\" href=\"/static/noliae.css\">\n</head>\n<body>\n  <header class=\"topbar\">\n    <a class=\"brand\" href=\"/\" aria-label=\"Noliae Search\">\n      <span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>\n      <span>noliae</span><b>search</b>\n    </a>\n    <nav aria-label=\"Navigation principale\">\n      <a href=\"https://ia.noliae.com\">Noliae IA</a>\n      <a href=\"#principes\">Notre approche</a>\n      <a class=\"account\" href=\"/compte\">Compte <span>↗</span></a>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero\" aria-labelledby=\"title\">\n      <p class=\"cap\"><i></i> Recherche Noliae <span>·</span> Beta</p>\n      <h1 id=\"title\">Explorer<br><em>sans bruit.</em></h1>\n      <p class=\"hero-copy\">Un moteur de recherche calme, connecté à vos espaces Noliae et construit pour retrouver l’essentiel.</p>\n      <form class=\"search-form\" action=\"/recherche\" method=\"get\">\n        <label class=\"sr-only\" for=\"q\">Rechercher sur Noliae</label>\n        <span class=\"search-icon\" aria-hidden=\"true\">⌕</span>\n        <input id=\"q\" name=\"q\" value=\""
    _o += html_escape(query)
    _o += "\" placeholder=\"Rechercher sur Noliae\" autocomplete=\"off\" autofocus>\n        <select name=\"mode\" aria-label=\"Type de recherche\">\n          <option value=\"text\">Web</option>\n          <option value=\"img\">Images</option>\n          <option value=\"ia\">Réponse IA</option>\n        </select>\n        <button type=\"submit\">Rechercher <b>↵</b></button>\n      </form>\n      <div class=\"quick-links\" aria-label=\"Recherches suggérées\">\n        <span>À essayer</span><a href=\"/recherche?q=Noliae&amp;mode=text\">Noliae</a><a href=\"/recherche?q=IA&amp;mode=ia\">IA</a><a href=\"/recherche?q=Documentation&amp;mode=text\">Documentation</a>\n      </div>\n    </section>\n\n    <section class=\"results-shell\" aria-live=\"polite\">\n      <aside class=\"filters\">\n        <p class=\"cap\">Affiner</p>\n        <a class=\"filter active\" href=\"/recherche?q="
    _o += html_escape(query)
    _o += "&amp;mode=text\"><span>◉</span> Tout</a>\n        <a class=\"filter\" href=\"/recherche?q="
    _o += html_escape(query)
    _o += "&amp;mode=img\"><span>○</span> Images</a>\n        <a class=\"filter\" href=\"/recherche?q="
    _o += html_escape(query)
    _o += "&amp;mode=ia\"><span>○</span> Réponse IA</a>\n        <div class=\"filter-note\"><i></i><p>Vos accès et limites sont appliqués par NolCore.</p></div>\n      </aside>\n      <div class=\"result-content\">\n        <div class=\"result-head\"><p class=\"cap\">Mode <strong>"
    _o += html_escape(mode)
    _o += "</strong></p><span>Recherche protégée par Noliae</span></div>\n        "
    if query == "" {
    _o += "\n          <article class=\"empty-state\">\n            <span class=\"empty-wave\">▂▅█▇█▅▂</span><h2>Prêt quand vous l’êtes.</h2><p>Commencez par une idée, une page ou un sujet. Noliae organise le reste.</p>\n          </article>\n        "
    } else {
    _o += "\n          <article class=\"result-card primary-result\">\n            <small>Résultat Noliae</small><h2>"
    _o += html_escape(query)
    _o += "</h2><p>"
    _o += html_escape(message)
    _o += "</p><a href=\"#core\">Ouvrir dans votre espace <span>→</span></a>\n          </article>\n          <article class=\"result-card\"><small>Fonctionnement</small><h3>Résultats reliés au Core</h3><p>Les requêtes passent par le gateway NolCore, ses permissions et ses limites avant toute réponse.</p></article>\n        "
    }
    _o += "\n      </div>\n    </section>\n\n    <section id=\"principes\" class=\"principles\">\n      <header><p class=\"cap\"><i></i> Principes de recherche</p><p>Une interface qui privilégie le signal.</p></header>\n      <div class=\"grid\">\n        <article><small>01 / UTILE</small><h2>Un résultat doit mériter votre attention.</h2><p>Hiérarchie claire, lecture fluide, aucun élément conçu pour distraire.</p></article>\n        <article><small>02 / CONNECTÉ</small><h2>La recherche parle à vos outils.</h2><p>Le Core rassemble sessions, données, crawler et recherche assistée par IA.</p></article>\n        <article><small>03 / MAÎTRISÉ</small><h2>Vos règles suivent chaque requête.</h2><p>Les permissions et les limites de débit restent appliquées côté serveur.</p></article>\n      </div>\n    </section>\n  </main>\n  <footer class=\"site-footer\"><span>© Noliae</span><a href=\"https://ia.noliae.com\">Noliae IA</a><a href=\"https://noliae.com\">Accueil</a><span class=\"version\">SEARCH / 01</span></footer>\n</body>\n</html>\n"
    return _o
}
