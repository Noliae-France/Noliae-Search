fn vue_search(titre: Text, query: Text, mode: Text, message: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#111111\">\n  <title>"
    _o += html_escape(titre)
    _o += " — Recherche</title>\n  <meta name=\"description\" content=\"Noliae Search : une recherche claire, reliée à vos services Noliae et protégée par le Core.\">\n  <meta name=\"robots\" content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\">\n  <link rel=\"canonical\" href=\"https://noliae.com/\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:locale\" content=\"fr_FR\">\n  <meta property=\"og:site_name\" content=\"Noliae\">\n  <meta property=\"og:title\" content=\"Noliae Search — Explorer sans bruit\">\n  <meta property=\"og:description\" content=\"Une recherche claire, reliée à vos services Noliae.\">\n  <meta property=\"og:url\" content=\"https://noliae.com/\">\n  <meta name=\"twitter:card\" content=\"summary\">\n  <meta name=\"twitter:title\" content=\"Noliae Search — Explorer sans bruit\">\n  <meta name=\"twitter:description\" content=\"Une recherche claire, reliée à vos services Noliae.\">\n  <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Noliae Search\",\"url\":\"https://noliae.com/\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://noliae.com/recherche?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}}</script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link rel=\"stylesheet\" href=\"/static/noliae.css\">\n  <style>@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}@keyframes scan{50%{transform:scaleX(.75);opacity:.55}}.hero>*{animation:rise .65s cubic-bezier(.2,.8,.2,1) both}.hero h1{animation-delay:.08s}.hero-copy{animation-delay:.16s}.search-form{animation-delay:.24s}.quick-links{animation-delay:.32s}.wave i:nth-child(4){animation:scan 1.6s ease-in-out infinite}.filter,.result-card,.grid article{transition:transform .2s ease,background .2s ease,border-color .2s ease}.filter:hover,.result-card:hover{transform:translateX(3px)}.grid article:hover{transform:translateY(-4px)}.empty-mark{width:54px;height:54px;object-fit:contain;margin-bottom:2px}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}</style>\n</head>\n<body>\n  <header class=\"topbar\">\n    <a class=\"brand\" href=\"/\" aria-label=\"Noliae Search\">\n      <span class=\"wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>\n      <span>noliae</span><b>search</b>\n    </a>\n    <nav aria-label=\"Navigation principale\">\n      <a href=\"https://ia.noliae.com\">Noliae IA</a>\n      <a href=\"#principes\">Notre approche</a>\n      <a class=\"account\" href=\"/compte\">Compte <span>↗</span></a>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero\" aria-labelledby=\"title\">\n      <p class=\"cap\"><i></i> Recherche Noliae <span>·</span> Beta</p>\n      <h1 id=\"title\">Explorer<br><em>sans bruit.</em></h1>\n      <p class=\"hero-copy\">Un moteur de recherche calme, connecté à vos espaces Noliae et construit pour retrouver l’essentiel.</p>\n      <form class=\"search-form\" action=\"/recherche\" method=\"get\">\n        <label class=\"sr-only\" for=\"q\">Rechercher sur Noliae</label>\n        <span class=\"search-icon\" aria-hidden=\"true\">⌕</span>\n        <input id=\"q\" name=\"q\" value=\""
    _o += html_escape(query)
    _o += "\" placeholder=\"Rechercher sur Noliae\" autocomplete=\"off\" autofocus>\n        <select name=\"mode\" aria-label=\"Type de recherche\">\n          <option value=\"text\">Web</option>\n          <option value=\"img\">Images</option>\n          <option value=\"ia\">Réponse IA</option>\n        </select>\n        <button type=\"submit\">Rechercher <b>↵</b></button>\n      </form>\n      <div class=\"quick-links\" aria-label=\"Recherches suggérées\">\n        <span>À essayer</span><a href=\"/recherche?q=Noliae&amp;mode=text\">Noliae</a><a href=\"/recherche?q=IA&amp;mode=ia\">IA</a><a href=\"/recherche?q=Documentation&amp;mode=text\">Documentation</a>\n      </div>\n    </section>\n\n    <section class=\"results-shell\" aria-live=\"polite\">\n      <aside class=\"filters\">\n        <p class=\"cap\">Affiner</p>\n        <a class=\"filter active\" href=\"/recherche?q="
    _o += html_escape(query)
    _o += "&amp;mode=text\"><span>◉</span> Tout</a>\n        <a class=\"filter\" href=\"/recherche?q="
    _o += html_escape(query)
    _o += "&amp;mode=img\"><span>○</span> Images</a>\n        <a class=\"filter\" href=\"/recherche?q="
    _o += html_escape(query)
    _o += "&amp;mode=ia\"><span>○</span> Réponse IA</a>\n        <div class=\"filter-note\"><i></i><p>Vos accès et limites sont appliqués par NolCore.</p></div>\n      </aside>\n      <div class=\"result-content\">\n        <div class=\"result-head\"><p class=\"cap\">Mode <strong>"
    _o += html_escape(mode)
    _o += "</strong></p><span>Recherche protégée par Noliae</span></div>\n        "
    if query == "" {
    _o += "\n          <article class=\"empty-state\">\n            <img class=\"empty-mark\" src=\"/static/symbol-dark.svg\" alt=\"\" aria-hidden=\"true\"><h2>Prêt quand vous l’êtes.</h2><p>Commencez par une idée, une page ou un sujet. Noliae organise le reste.</p>\n          </article>\n        "
    } else {
    _o += "\n          <article class=\"result-card primary-result\">\n            <small>Résultat Noliae</small><h2>"
    _o += html_escape(query)
    _o += "</h2><p>"
    _o += html_escape(message)
    _o += "</p><a href=\"#core\">Ouvrir dans votre espace <span>→</span></a>\n          </article>\n          <article class=\"result-card\"><small>Fonctionnement</small><h3>Résultats reliés au Core</h3><p>Les requêtes passent par le gateway NolCore, ses permissions et ses limites avant toute réponse.</p></article>\n        "
    }
    _o += "\n      </div>\n    </section>\n\n    <section id=\"principes\" class=\"principles\">\n      <header><p class=\"cap\"><i></i> Principes de recherche</p><p>Une interface qui privilégie le signal.</p></header>\n      <div class=\"grid\">\n        <article><small>01 / UTILE</small><h2>Un résultat doit mériter votre attention.</h2><p>Hiérarchie claire, lecture fluide, aucun élément conçu pour distraire.</p></article>\n        <article><small>02 / CONNECTÉ</small><h2>La recherche parle à vos outils.</h2><p>Le Core rassemble sessions, données, crawler et recherche assistée par IA.</p></article>\n        <article><small>03 / MAÎTRISÉ</small><h2>Vos règles suivent chaque requête.</h2><p>Les permissions et les limites de débit restent appliquées côté serveur.</p></article>\n      </div>\n    </section>\n  </main>\n  <footer class=\"site-footer\"><span>© Noliae</span><a href=\"https://ia.noliae.com\">Noliae IA</a><a href=\"https://noliae.com\">Accueil</a><span class=\"version\">SEARCH / 01</span></footer>\n</body>\n<script>(async()=>{const h=location.hostname;const a=h.startsWith(\"search.\")?location.protocol+\"//api.\"+h.slice(7):location.origin;try{const r=await fetch(a+\"/v1/branding\");if(!r.ok)return;const b=await r.json(),n=b.name||\"NolCore\";document.title=n+\" — Recherche\";document.querySelectorAll(\"a\").forEach(x=>{if(x.href.includes(\"ia.\"))x.href=b.ia_url||x.href;else if(x.href.includes(\"noliae.com\"))x.href=b.website_url||x.href});document.querySelectorAll(\".brand span:not(.wave),.site-footer span:first-child\").forEach(x=>{if(x.textContent.includes(\"noliae\")||x.textContent.includes(\"Noliae\"))x.textContent=x.textContent.replace(/noliae/gi,n)})}catch(_){}})();</script>\n</html>\n"
    return _o
}
